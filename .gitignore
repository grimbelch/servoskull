# Secrets — never commit
.env
.spotify_cache

# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# macOS
.DS_Store

# Runtime state — generated at runtime, may contain personal data extracted from
# conversations (names, addresses, etc.). Never commit.
history.json
memory.json
longterm_memory.json
reminders.json
mood.json
quiet.json
current_game.json
campaigns/*.json
games/roleplay/campaigns/*.json

*.json.bak

# Per-user configuration written by the setup wizard (keys + personal details).
# owner.example.json IS committed as a template; owner.json is the user's real data.
owner.json
settings.json

# Claude Code local settings
.claude/

# Offline game rulesets the skull references (see skull/search.py, RULES_DIR).
# Official Games Workshop rules text (Necromunda, Warhammer 40k) is copyrighted —
# kept local only, never committed to this public repo.
*.pdf
games/rules/*
games/*/rules/manuals/*
games/*/rules/**/*.pdf
Rules/*
!games/rules/README.md
!games/rules/ingest_pdf.py
!games/rules/clean_necromunda_tables.py
!games/rules/netepic/
!games/rules/netea/
!Rules/README.md
!Rules/ingest_pdf.py
!Rules/clean_necromunda_tables.py
# Extracted module page images — hundreds of MB of copyrighted Games Workshop
# artwork. Regenerate locally with games/wfrp/extract_images.py.
games/*/rules/**/images/

# Generated TTS phrase cache — rebuilt on demand per personality.
models/phrase_cache/

# Scratch and temporary scripts
scratch/
scratch_*.py
scratch_*/
debug_*.py
apply_*.py
export_json.py
import_json.py
modules_export.json
extract_js.py
fix.py
mock_*.js
run_*.js
test*
update_walkthrough.py
skull/web_bak.py
skull/web_new.py
skull/web_server.py

# Adventure module content extracted from Foundry VTT. The artwork and prose are
# licensed Cubicle 7 material, reproducible from a local Foundry install with
# games/wfrp/extract/foundry_export.cjs, so only the extractor is tracked.
games/wfrp/rules/modules/
*.foundry-export.json

# Biometric data (face photos, trained face/voice models) must never be committed
**/faces/
*.pkl

# Games Workshop / Cubicle 7 rulebook text and artwork is copyrighted. It is built
# locally (games/ingest_pdf.py, games/wfrp/extract) from books you own and stays on
# the device; never commit it. Our own LLM rules summaries are the exception.
games/warhammer40k/rules/
games/necromunda/rules/
games/wfrp/rules/*
!games/wfrp/rules/llm_*.md

# Emulator ROMs are copyrighted system firmware: supplied by the user, never committed.
games/roms/
*.zip
