#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# switch-personality  —  toggle between personalities on this Pi
#
# Usage:
#   switch-personality <target>
#
# The script updates SKULL_NAME in .env and restarts the active service.
# ─────────────────────────────────────────────────────────────────────────────

set -euo pipefail

BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="$BASE_DIR/.env"

# Find the active service (omega7 or omega8)
current_svc=""
if systemctl is-active --quiet omega8.service >/dev/null 2>&1; then
    current_svc="omega8.service"
elif systemctl is-active --quiet omega7.service >/dev/null 2>&1; then
    current_svc="omega7.service"
else
    # Fallback to the hostname-based service
    current_svc="$(hostname).service"
fi

target="${1:-}"

if [[ -z "$target" || "$target" == "status" ]]; then
    echo "Usage: switch-personality <target>"
    echo "Available personalities:"
    python3 -c '
import json, sys
try:
    with open("'"$BASE_DIR"'/personalities/personalities.json") as f:
        data = json.load(f)["personalities"]
    for k, v in data.items():
        print(f"  {k} - {v.get(\"name\", k)}")
except:
    pass
'
    exit 1
fi

target="${target,,}" # lowercase

label=$(python3 -c '
import json, sys
try:
    with open("'"$BASE_DIR"'/personalities/personalities.json") as f:
        data = json.load(f)["personalities"]
    target = "'"$target"'"
    if target in data:
        print(data[target].get("name", target))
        sys.exit(0)
    sys.exit(1)
except Exception as e:
    print(f"Error parsing json: {e}", file=sys.stderr)
    sys.exit(1)
') || {
    echo "ERROR: unknown personality '$target'." >&2
    exit 1
}

echo "🔄 Switching to $label ($target) ..."

# 1. Update the .env file
if [[ -f "$ENV_FILE" ]] && grep -q "^SKULL_NAME=" "$ENV_FILE"; then
    sudo sed -i "s/^SKULL_NAME=.*/SKULL_NAME=$target/" "$ENV_FILE"
else
    echo "SKULL_NAME=$target" | sudo tee -a "$ENV_FILE" >/dev/null
fi

# 2. Restart the active service to load the new config
echo "Restarting $current_svc ..."
sudo pkill -9 -f 'core.main' 2>/dev/null || true
sudo systemctl restart "$current_svc" || true

echo "✅ $label is active on $current_svc."
