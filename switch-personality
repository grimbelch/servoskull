#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# switch-personality  —  toggle between Jax and Omega-7 on this Pi
#
# Usage:
#   switch-personality jax       # switch to Jax (golden retriever)
#   switch-personality omega7    # switch to Omega-7 (servo skull)
#
# The script updates SKULL_NAME in .env and restarts the active service.
# ─────────────────────────────────────────────────────────────────────────────

set -euo pipefail

ENV_FILE="/home/sspeer/Servoskull/.env"

# Find the active service (omega7 or omega8)
current_svc=""
if systemctl is-active --quiet omega8.service; then
    current_svc="omega8.service"
elif systemctl is-active --quiet omega7.service; then
    current_svc="omega7.service"
else
    # Fallback to the hostname-based service
    current_svc="$(hostname).service"
fi

switch_to() {
    local target="$1"         # jax | omega7
    local label

    if [[ "$target" == "jax" ]]; then
        label="Jax (Golden Retriever)"
    elif [[ "$target" == "omega7" ]]; then
        label="Omega-7 (Servo Skull)"
    else
        echo "ERROR: unknown personality '$target'. Use 'jax' or 'omega7'." >&2
        exit 1
    fi

    echo "🔄 Switching to $label ..."

    # 1. Update the .env file
    if grep -q "^SKULL_NAME=" "$ENV_FILE"; then
        sudo sed -i "s/^SKULL_NAME=.*/SKULL_NAME=$target/" "$ENV_FILE"
    else
        echo "SKULL_NAME=$target" | sudo tee -a "$ENV_FILE" >/dev/null
    fi

    # 2. Restart the active service to load the new config
    echo "Restarting $current_svc ..."
    sudo pkill -9 -f 'core.main' 2>/dev/null || true
    sudo systemctl restart "$current_svc"

    echo "✅ $label is active on $current_svc."
}

case "${1:-status}" in
    jax|JAX)         switch_to "jax"   ;;
    omega7|OMEGA7)   switch_to "omega7" ;;
    *)
        echo "Usage: switch-personality [jax|omega7]"
        exit 1
        ;;
esac
