# NOTE ON COMMENTS: keep them on their own line. A trailing comment after a value
# ("FOO=true  # why") is stripped by python-dotenv but NOT by systemd's
# EnvironmentFile, and on the appliance systemd parses this file first — so the
# value would arrive as "true  # why". A boolean silently reads false; a float
# raises at import and the service will not start.

# Omega-7 Servo Skull — environment configuration
#
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed. Only ANTHROPIC_API_KEY and
# OPENAI_API_KEY are needed for the basic voice loop (brain + speech-to-text);
# everything else has a sensible default or is for optional features/hardware.
#
# ── Configuration model ───────────────────────────────────────────────────────
# Every user-facing setting below resolves in this order (see core/config.py):
#     1. settings.json in the user-data dir  (written by the setup wizard)
#     2. this .env / the environment          (developer convenience)
#     3. built-in default
# So on a consumer unit the wizard owns settings.json and .env can be absent.
# Personalization (owner's name, location, family, etc.) lives separately in
# owner.json — see owner.example.json for the shape.
#
# OMEGA7_DATA_DIR: writable directory for all runtime/user data (settings.json,
# owner.json, the state database, TLS key, face/voice profiles, etc.). Defaults
# to ~/.config/omega7; an appliance image can point it at e.g. /var/lib/omega7.
#OMEGA7_DATA_DIR=/var/lib/omega7

# ── Identity / personalization ───────────────────────────────────────────────────
# The skull's own name — spoken in its boot line, referenced throughout its persona,
# and biased into speech recognition. Owner-settable at setup. Personal details about
# the owner (name, location, family, etc.) live in owner.json — see owner.example.json.
SKULL_NAME=Omega-7

# ── Required: core LLM + speech-to-text ──────────────────────────────────────────
# Brain (Claude). Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-key-here
# Whisper speech-to-text. Get one at https://platform.openai.com/
OPENAI_API_KEY=your-openai-key-here
# Claude model used for the brain, idle utterances, memory extraction, and vision.
CLAUDE_MODEL=claude-haiku-4-5-20251001
# Speech-to-text model. gpt-4o-mini-transcribe is faster and more accurate than whisper-1.
STT_MODEL=whisper-1
# Stream audio to a realtime transcription session while you speak, so the text is
# ready the moment you stop (falls back to STT_MODEL on any problem).
STT_STREAMING=true
STT_STREAMING_MODEL=gpt-4o-mini-transcribe

# ── Text-to-speech ──────────────────────────────────────────────────────────────
# "piper" = local, free, offline. "elevenlabs" = cloud voice (quota-limited).
TTS_BACKEND=elevenlabs
# Local Piper voice model (downloaded separately; see PI_SETUP_GUIDE.md).
PIPER_MODEL_PATH=models/servoskull.onnx
# ElevenLabs — only needed if TTS_BACKEND=elevenlabs or you use the canned phrases.
ELEVENLABS_API_KEY=your-elevenlabs-key-here
# Voice model. eleven_flash_v2_5 answers fastest; eleven_turbo_v2 sounds a little richer.
ELEVENLABS_MODEL=eleven_turbo_v2
# The voice is set PER PERSONALITY, keyed by the skull's name in upper case, so one
# file can hold a voice for each (ELEVENLABS_VOICE_ID_OMEGA-7, ELEVENLABS_VOICE_ID_JAX).
# Unset, each personality's default from personalities/<key>/config.json is used.
# A plain ELEVENLABS_VOICE_ID is NOT read.
ELEVENLABS_VOICE_ID_OMEGA-7=your-elevenlabs-voice-id-here
# Set to true for ONE run to wipe and regenerate the cached canned-phrase audio
# after changing the ElevenLabs voice. Set back to false afterward.
RESET_VOICE_CACHE=false

# ── Wake word (openWakeWord) ─────────────────────────────────────────────────────
# A built-in model name (e.g. "hey_jarvis") or a path to a custom .onnx model.
# Per personality like the voice (WAKE_WORD_MODEL_OMEGA-7, WAKE_WORD_MODEL_JAX);
# unset, the personality's default is used. A plain WAKE_WORD_MODEL is NOT read.
WAKE_WORD_MODEL_OMEGA-7=hey_jarvis
WAKE_WORD_THRESHOLD=0.5
# Barging in on the skull mid-sentence is harder than waking a silent one, so it
# gets its own threshold. The echo canceller subtracts the skull's own voice, but
# during double-talk WebRTC AEC attenuates whoever is talking over it as well, so
# the same wake word scores lower. Measured on this build: 0.586 and 0.687 over
# speech against 0.759 for the same word said into silence.
# Lower = easier to interrupt, and more false triggers. Raise it if the skull
# starts waking itself — but check `pactl get-default-source` really is
# echo_cancel.source first, because a mis-seated AEC source self-triggers at any
# value.
WAKE_WORD_THRESHOLD_BARGE_IN=0.40
# Save the ~2 s of audio behind each detection to WAKE_CAPTURE_DIR, named by score,
# mode (idle/barge-in) and outcome (fired/miss). True and false wake scores overlap
# almost completely, so neither threshold above can be chosen from the log alone —
# the only fix for a false trigger is retraining on the room noise that caused it,
# and that needs the audio. Leave off for normal use; it writes a file per wake.
WAKE_CAPTURE=false
WAKE_CAPTURE_DIR=~/.config/omega7/wake_clips
# With capture on, also keep the near misses that scored at least this but did not
# fire. Tuning the barge-in threshold means knowing what the summons that FAILED
# scored, and a miss leaves no other trace — the log only ever records successes.
WAKE_CAPTURE_FLOOR=0.25
# A wake followed by near-total silence was a false trigger on ambient noise, not a
# summons. If the loudest part of what follows is below this fraction of
# SILENCE_THRESHOLD (so 180 x 0.55 = 99 by default) nobody spoke at all, and the
# skull stays quiet instead of announcing itself to an empty room. Above it,
# someone spoke too quietly and still deserves an answer.
FALSE_WAKE_RMS_RATIO=0.55

# ── Foundry VTT bridge (optional, WFRP games) ───────────────────────────
# Off unless enabled; with it off none of the rest is read and no tools are added.
FOUNDRY_MCP_ENABLED=false
# The DIRECTORY holding the MCP server's entry point, not the file itself — the
# code looks for index.cjs inside it, then index.js. The desktop installer ships
# index.cjs (node refuses the standalone ZIP's index.js, which is published as an
# ES module). A manual clone: /path/to/foundry-vtt-mcp/packages/mcp-server/dist
FOUNDRY_MCP_SERVER_DIR=~/foundry-mcp-server
# The node binary to run it with; an absolute path if node is not on PATH for the
# service user.
FOUNDRY_MCP_NODE=node
# Seconds to wait for one tool call, and for the server to come up at all. The
# startup budget is the longer of the two because Foundry's own reconnect window
# is short and the browser needs a moment to attach.
FOUNDRY_MCP_TIMEOUT=30
FOUNDRY_MCP_STARTUP_TIMEOUT=45
# Comma-separated whitelist overriding the default tool set. Empty = the defaults.
FOUNDRY_MCP_TOOLS=

# ── Audio devices ────────────────────────────────────────────────────────────────
# Mic: numeric sounddevice index, "-1" for system default, or a name substring
# (e.g. "USB") which survives device re-enumeration. Run `python _miccheck.py` to find it.
MIC_DEVICE_INDEX=-1
# Software mic gain (PipeWire source volume, cubic scale: 2.0 is about +18 dB). Raise
# if recordings peak well under 20% of full scale, lower if they near 100% (see
# "[audio] done" in the log).
MIC_SOFT_GAIN=2.0
# End-of-speech detection (Silero VAD). A command ends VAD_END_SILENCE seconds after
# you stop talking; raise it if the skull cuts you off mid-sentence, lower it for
# snappier replies. SILENCE_DURATION then only bounds the wait for you to start.
VAD_ENABLED=true
VAD_THRESHOLD=0.5
VAD_END_SILENCE=0.7
# Output device index ("-1" = system default).
AUDIO_OUTPUT_DEVICE=-1
# Pinned device for Omega-7's own voice/SFX (stays on the local speaker even when a
# Bluetooth speaker is the system default). Defaults to AUDIO_OUTPUT_DEVICE if unset.
VOICE_OUTPUT_DEVICE=-1

# ── Weather (get_weather tool) ───────────────────────────────────────────────────
# Your latitude/longitude (decimal degrees). Open-Meteo, no API key required.
# Left at 0.0/0.0 the weather tool reports "not configured".
WEATHER_LAT=0.0
WEATHER_LON=0.0

# ── Spotify (optional music control; Premium required) ───────────────────────────
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your-spotify-client-id-here
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret-here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Spotify Connect device name for local playback (e.g. Raspotify on the Pi).
SPOTIFY_DEVICE_NAME=Omega-7

# ── Google Home / Chromecast audio (optional) ────────────────────────────────────
# Friendly name of the cast device; leave blank to disable casting.
GOOGLE_HOME_DEVICE=
# Opt-in on macOS, opt-out on Linux/Pi. Requires the pychromecast package.
CAST_ENABLED=false

# ── Camera / motion-triggered vision (optional) ──────────────────────────────────
CAMERA_ENABLED=false
CAMERA_DEVICE_INDEX=0
# ~8% of a 640x480 frame must change to count as motion (raise to desensitize).
CAMERA_MOTION_THRESHOLD=25000
# Min seconds between vision calls triggered by motion.
CAMERA_COOLDOWN=120
# Hard ceiling on vision calls per rolling hour (API-budget backstop).
CAMERA_MAX_PER_HOUR=15
# Mean brightness (0-255) below which a frame is treated as blank/dark and skipped.
CAMERA_MIN_BRIGHTNESS=20
# Coarse rotation for how the camera is mounted: 0, 90, 180 or 270 (clockwise).
CAMERA_ROTATION=270
# Fine tilt correction after CAMERA_ROTATION, degrees counter-clockwise (negative = clockwise).
CAMERA_FINE_ROTATION=0

# ── Proximity (VL53L1X rangefinder, optional) ────────────────────────────────────
PROXIMITY_ENABLED=false
# Range for proximity-triggered vision.
PROXIMITY_THRESHOLD_CM=150
# Range for the morning greeting + briefing offer (someone seated at the desk).
MORNING_GREETING_DISTANCE_CM=300

# ── Eye LEDs (Individually Addressable WS2812B RGB LEDs, BCM numbering) ─────────
# 2 WS2812B LEDs (Left Eye, Right Eye; 3rd lens housing is mounted with the Camera).
EYE_LED_PIN=18
EYE_LED_COUNT=2

# Legacy GPIO PWM pins (optional fallback)
LED_PIN_LEFT=22
LED_PIN_CENTER=23
LED_PIN_RIGHT=27

# ── GC9A01 round face display (optional, Pi only — wiring in config.py) ───────────
DISPLAY_ENABLED=false
DISPLAY_SPI_BUS=0
DISPLAY_SPI_DEVICE=0
DISPLAY_SPI_HZ=40000000
DISPLAY_DC_PIN=25
DISPLAY_RST_PIN=24
DISPLAY_BL_PIN=12
DISPLAY_ROTATION=0
# Software rotation offset in degrees (this build's calibrated default is 18.0;
# adjust by voice: "rotate the display").
DISPLAY_FINE_ROTATION=0.0

# ── Internal temperature monitoring (Pi only; no-op without a thermal sensor) ─────
TEMP_MONITOR_ENABLED=true
TEMP_WARN_THRESHOLD=80
TEMP_CLEAR_THRESHOLD=72
TEMP_CHECK_INTERVAL=30
TEMP_WARN_COOLDOWN=300

# ── Game rulesets (offline reference) ──────────────────────────────────────────────
# Folder holding the rulebook Markdown the skull consults locally (built with
# games/ingest_pdf.py from books you own; gitignored). Each game gets a subfolder,
# e.g. games/rules/necromunda. Relative to the repo, or an absolute path.
RULES_DIR=games/rules

# ── Misc ─────────────────────────────────────────────────────────────────────────
# Legacy JSON conversation history (imported into the SQLite state database on
# first run; new history is written only to the database).
HISTORY_FILE=history.json
# Set true to print per-chunk RMS while recording and save debug WAVs to /tmp.
AUDIO_DEBUG=false
